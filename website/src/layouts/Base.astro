---
import '../styles/fluent.css';
import icon16 from '../../../src/Fluorite.App/Assets/Square44x44Logo.targetsize-16_altform-unplated.png?url';
import icon32 from '../../../src/Fluorite.App/Assets/Square44x44Logo.targetsize-32_altform-unplated.png?url';
import icon48 from '../../../src/Fluorite.App/Assets/Square44x44Logo.targetsize-48_altform-unplated.png?url';
import ogImage from '../../../src/Fluorite.App/Assets/Wide310x150Logo.scale-400.png?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { type Lang, locales, strings } from '../i18n';

interface Props {
    lang: Lang;
    title: string;
    description: string;
    page?: 'privacy' | 'terms';
    /** The same page in each language, for hreflang links. */
    alternates?: Partial<Record<Lang, string>>;
    /** Keep the page out of search results (the 404 page). */
    noindex?: boolean;
    /** schema.org data (JSON-LD) about the page. */
    structuredData?: object;
    /** ISO date the page's content last changed; makes it an article for link previews. */
    modified?: string;
}

const { lang, title, description, page, alternates = {}, noindex = false, structuredData, modified } = Astro.props;
const s = strings[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const altEntries = Object.entries(alternates) as [Lang, string][];
---

<!doctype html>
<html lang={locales[lang].htmlLang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
        {altEntries.map(([l, path]) => <link rel="alternate" hreflang={locales[l].htmlLang} href={new URL(path, site).href} />)}
        {altEntries.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en ?? '/', site).href} />}
        <link rel="sitemap" href="/sitemap.xml" />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f3f3" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#202020" />
        <link rel="icon" type="image/png" sizes="16x16" href={icon16} />
        <link rel="icon" type="image/png" sizes="32x32" href={icon32} />
        <link rel="icon" type="image/png" sizes="48x48" href={icon48} />
        <meta property="og:type" content={modified ? 'article' : 'website'} />
        {modified && <meta property="article:modified_time" content={modified} />}
        <meta property="og:site_name" content="Fluorite Launcher" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={locales[lang].ogLocale} />
        {altEntries.filter(([l]) => l !== lang).map(([l]) => <meta property="og:locale:alternate" content={locales[l].ogLocale} />)}
        <meta property="og:image" content={new URL(ogImage, site).href} />
        <meta property="og:image:width" content="1240" />
        <meta property="og:image:height" content="600" />
        <meta property="og:image:alt" content={s.logoAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        {
            structuredData && (
                // Data, not code: browsers never run it. `<` is escaped so the JSON can't close the tag.
                <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
            )
        }
        <slot name="head" />
    </head>
    <body>
        <a class="skip button" href="#content">{s.skip}</a>
        <Header lang={lang} page={page} />
        <div class="layer">
            <main id="content">
                <slot />
            </main>
            <Footer lang={lang} />
        </div>
    </body>
</html>
