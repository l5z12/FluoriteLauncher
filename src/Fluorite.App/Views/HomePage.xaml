<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fluorite.App.Views.HomePage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluorite.App.Views"
    xmlns:vm="using:Fluorite.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="20">
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />

            <InfoBar x:Uid="Home_NeedsAccountBar" IsOpen="{x:Bind ViewModel.NeedsAccount, Mode=OneWay}" IsClosable="False" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Uid="Home_GoAccounts" Click="GoAccounts_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Continue playing -->
            <TextBlock x:Uid="Home_ContinuePlaying" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recent}" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled" Visibility="{x:Bind local:Bind.Visible(ViewModel.HasRecent), Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <local:FillGridLayout MinItemWidth="300" MinItemHeight="112" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstanceItem">
                        <Button Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Tag="{x:Bind}" Click="Recent_Click" CornerRadius="8" AutomationProperties.Name="{x:Bind Name}"
                                PreviewKeyDown="Card_PreviewKeyDown">
                            <Button.ContextFlyout>
                                <MenuFlyout Opening="InstanceMenu_Opening">
                                    <MenuFlyoutItem x:Uid="Menu_Play" Tag="{x:Bind}" Click="Play_Click" KeyboardAcceleratorTextOverride="Ctrl+Enter" IsEnabled="{x:Bind local:Bind.Not(IsRunning), Mode=OneWay}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSubItem x:Uid="Menu_LaunchAs" Tag="{x:Bind}" IsEnabled="{x:Bind local:Bind.Not(IsRunning), Mode=OneWay}">
                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutSubItem.Icon>
                                        <MenuFlyoutItem Text="…" IsEnabled="False" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem x:Uid="Menu_Open" Tag="{x:Bind}" Click="Recent_Click" KeyboardAcceleratorTextOverride="Enter">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <Grid Padding="16" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="8" VerticalAlignment="Center">
                                    <Grid>
                                        <Border Background="{ThemeResource FluoriteBrandBrush}" Visibility="{x:Bind local:Bind.Collapsed(HasIcon)}">
                                            <TextBlock Text="{x:Bind Initial}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource FluoriteOnBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{x:Bind Icon}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" local:TrimToolTip.IsEnabled="True" />
                                    <TextBlock Text="{x:Bind VersionText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" local:TrimToolTip.IsEnabled="True" />
                                    <TextBlock Text="{x:Bind LastPlayedText}" ToolTipService.ToolTip="{x:Bind LastPlayedTooltip}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Tag="{x:Bind}" Click="Play_Click"
                                        IsEnabled="{x:Bind local:Bind.Not(IsRunning), Mode=OneWay}" AutomationProperties.Name="{x:Bind PlayName}"
                                        ToolTipService.ToolTip="{x:Bind PlayLabel, Mode=OneWay}" IsTabStop="False">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind local:Bind.Visible(ViewModel.ShowNoInstances), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Home_Empty" TextWrapping="Wrap" />
                    <Button x:Uid="Home_CreateFirst" Style="{StaticResource AccentButtonStyle}" Click="GoLibrary_Click" />
                </StackPanel>
            </Border>

            <!-- Latest versions. While they load: a ring where the version goes, or (Settings › While Home loads) no cards
                 until there's a version. The ring overlays the empty text, so the card keeps its height when it arrives. -->
            <Grid ColumnSpacing="12" Visibility="{x:Bind local:Bind.Visible(ViewModel.ShowVersionCards), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Once its version is in, a click does what Settings › Clicking a version card says; the menu has every choice. -->
                <Button x:Name="ReleaseCard" Tag="release" Click="VersionCard_Click" IsEnabled="{x:Bind ViewModel.HasLatestRelease, Mode=OneWay}"
                        Padding="16" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind ViewModel.ReleaseCardName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ReleaseCardTip, Mode=OneWay}">
                    <Button.ContextFlyout>
                        <MenuFlyout Opening="VersionMenu_Opening">
                            <MenuFlyoutItem x:Uid="Home_VersionNewInstance" Tag="release" Click="VersionNewInstance_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ReleasePatchNotesItem" x:Uid="Home_VersionPatchNotes" Tag="release" Click="VersionPatchNotes_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Home_VersionCopy" Tag="release" Click="VersionCopy_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Home_LatestRelease" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.LatestRelease, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource FluoriteBrandBrush}" />
                                <ProgressRing x:Uid="Home_LoadingVersions" IsActive="{x:Bind ViewModel.IsLoadingVersions, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="{x:Bind ViewModel.CardActionGlyph, Mode=OneWay}" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind local:Bind.Visible(ViewModel.HasLatestRelease), Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button x:Name="SnapshotCard" Grid.Column="1" Tag="snapshot" Click="VersionCard_Click" IsEnabled="{x:Bind ViewModel.HasLatestSnapshot, Mode=OneWay}"
                        Padding="16" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind ViewModel.SnapshotCardName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SnapshotCardTip, Mode=OneWay}">
                    <Button.ContextFlyout>
                        <MenuFlyout Opening="VersionMenu_Opening">
                            <MenuFlyoutItem x:Uid="Home_VersionNewInstance" Tag="snapshot" Click="VersionNewInstance_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SnapshotPatchNotesItem" x:Uid="Home_VersionPatchNotes" Tag="snapshot" Click="VersionPatchNotes_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Home_VersionCopy" Tag="snapshot" Click="VersionCopy_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Home_LatestSnapshot" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.LatestSnapshot, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource FluoriteTealBrush}" />
                                <ProgressRing x:Uid="Home_LoadingVersions" IsActive="{x:Bind ViewModel.IsLoadingVersions, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="{x:Bind ViewModel.CardActionGlyph, Mode=OneWay}" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind local:Bind.Visible(ViewModel.HasLatestSnapshot), Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Patch notes -->
            <TextBlock x:Uid="Home_PatchNotes" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="{x:Bind local:Bind.Visible(ViewModel.ShowNewsHeaders), Mode=OneWay}" />
            <ProgressRing x:Uid="Home_LoadingNews" IsActive="{x:Bind ViewModel.ShowNewsLoading, Mode=OneWay}" Visibility="{x:Bind local:Bind.Visible(ViewModel.ShowNewsLoading), Mode=OneWay}"
                          Width="24" Height="24" HorizontalAlignment="Left" />
            <ItemsRepeater x:Name="PatchNotesRepeater" ItemsSource="{x:Bind ViewModel.PatchNotes}" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled">
                <ItemsRepeater.Layout>
                    <local:FillGridLayout MinItemWidth="240" MinItemHeight="300" MaxColumns="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:NewsCard">
                        <Button Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                Tag="{x:Bind}" Click="PatchNote_Click" CornerRadius="8" AutomationProperties.Name="{x:Bind Title}"
                                PreviewKeyDown="ArticleCard_PreviewKeyDown">
                            <Button.ContextFlyout>
                                <MenuFlyout Opening="PatchNoteMenu_Opening">
                                    <MenuFlyoutItem x:Uid="Menu_Open" Tag="{x:Bind}" Click="PatchNote_Click" KeyboardAcceleratorTextOverride="Enter">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Home_NewsOpen" Tag="{x:Bind}" Click="OpenInBrowser_Click" IsEnabled="{x:Bind HasLink}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Home_PatchNoteOpenWiki" Tag="{x:Bind}" Click="OpenWiki_Click" IsEnabled="{x:Bind HasWikiLink}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="Home_NewsCopyLink" Tag="{x:Bind}" Click="CopyLink_Click" KeyboardAcceleratorTextOverride="Ctrl+C" IsEnabled="{x:Bind HasLink}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Home_PatchNoteCopyWikiLink" Tag="{x:Bind}" Click="CopyWikiLink_Click" IsEnabled="{x:Bind HasWikiLink}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <StackPanel>
                                <Image Source="{x:Bind Image}" Height="140" Stretch="UniformToFill" />
                                <StackPanel Padding="14,10,14,14" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- News -->
            <TextBlock x:Uid="Home_News" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="{x:Bind local:Bind.Visible(ViewModel.HasNews), Mode=OneWay}" />
            <ItemsRepeater x:Name="NewsRepeater" ItemsSource="{x:Bind ViewModel.News}" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled">
                <ItemsRepeater.Layout>
                    <local:FillGridLayout MinItemWidth="320" MinItemHeight="250" MaxColumns="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:NewsCard">
                        <Button Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                Tag="{x:Bind}" Click="OpenInBrowser_Click" CornerRadius="8" AutomationProperties.Name="{x:Bind Title}"
                                PreviewKeyDown="ArticleCard_PreviewKeyDown">
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="Home_NewsOpen" Tag="{x:Bind}" Click="OpenInBrowser_Click" KeyboardAcceleratorTextOverride="Enter" IsEnabled="{x:Bind HasLink}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Home_NewsCopyLink" Tag="{x:Bind}" Click="CopyLink_Click" KeyboardAcceleratorTextOverride="Ctrl+C" IsEnabled="{x:Bind HasLink}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <StackPanel>
                                <Image Source="{x:Bind Image}" Height="150" Stretch="UniformToFill" />
                                <StackPanel Padding="14,10,14,14" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock x:Uid="Home_Disclaimer" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
