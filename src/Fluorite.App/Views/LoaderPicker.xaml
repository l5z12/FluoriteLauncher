<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fluorite.App.Views.LoaderPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluorite.App.Views"
    xmlns:vm="using:Fluorite.App.ViewModels"
    xmlns:loaders="using:Fluorite.Modding.Loaders">

    <StackPanel Spacing="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:LoaderComboBox x:Uid="Loader_Picker" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Options}" SelectedIndex="{x:Bind ViewModel.SelectedOptionIndex, Mode=TwoWay}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoaderOption">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <!-- No explicit brush: a disabled item dims the note together with the name. -->
                            <TextBlock Grid.Column="1" Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </local:LoaderComboBox>
            <Grid Grid.Column="1" Visibility="{x:Bind local:Bind.Visible(ViewModel.HasLoader), Mode=OneWay}">
                <ComboBox x:Uid="Loader_VersionPicker" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Versions}" SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="loaders:LoaderVersion">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Version}" />
                                <TextBlock x:Uid="Loader_RecommendedTag" Foreground="{ThemeResource FluoriteTealBrush}"
                                           Visibility="{x:Bind local:Bind.Visible(Recommended)}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,10" />
            </Grid>
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   Visibility="{x:Bind local:Bind.VisibleIfText(ViewModel.Message), Mode=OneWay, FallbackValue=Collapsed}" />
    </StackPanel>
</UserControl>
