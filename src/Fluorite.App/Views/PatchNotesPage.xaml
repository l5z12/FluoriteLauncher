<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fluorite.App.Views.PatchNotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,24,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
            <TextBlock x:Name="DateText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <WebView2 x:Name="Viewer" DefaultBackgroundColor="Transparent" />
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="32" Height="32" />
            </Grid>
        </Border>
    </Grid>
</Page>
