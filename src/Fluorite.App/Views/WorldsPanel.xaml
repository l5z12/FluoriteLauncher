<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fluorite.App.Views.WorldsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluorite.App.Views"
    xmlns:vm="using:Fluorite.App.ViewModels">

    <Grid RowSpacing="8" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Import_Click" x:Uid="Worlds_ImportButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                    <TextBlock x:Uid="Worlds_Import" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.OpenBackupsFolderCommand, Mode=OneWay}" x:Uid="Worlds_BackupsFolderButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEA35;" FontSize="14" />
                    <TextBlock x:Uid="Worlds_BackupsFolder" />
                </StackPanel>
            </Button>
            <ProgressRing Grid.Column="2" HorizontalAlignment="Left" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBox x:Name="FilterBox" Grid.Column="3" x:Uid="Content_Filter" Width="220" Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="4" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}" x:Uid="Common_OpenFolderButton">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
            </Button>
            <Button Grid.Column="5" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" x:Uid="Content_RefreshButton">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar x:Uid="Worlds_RunningBar" Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.IsGameRunning, Mode=OneWay}" />
            <InfoBar x:Uid="Worlds_NoQuickPlayBar" Severity="Informational" IsClosable="True"
                     IsOpen="{x:Bind local:WorldsPanel.ShowNoQuickPlay(ViewModel.CanOpenWorlds, ViewModel.IsEmpty), Mode=OneWay}" />
            <InfoBar Severity="Success" IsClosable="True" IsOpen="{x:Bind local:Bind.IsNotNull(ViewModel.Status), Mode=OneWay, FallbackValue=False}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" />
            <InfoBar Severity="Error" IsClosable="True" IsOpen="{x:Bind local:Bind.IsNotNull(ViewModel.Error), Mode=OneWay, FallbackValue=False}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            <local:UndoBar Offer="{x:Bind ViewModel.PendingUndo, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="List" ItemsSource="{x:Bind ViewModel.Worlds, Mode=OneWay}" SelectionMode="Single"
                      SelectedItem="{x:Bind ViewModel.SelectedWorld, Mode=TwoWay}" ContainerContentChanging="List_ContainerContentChanging"
                      ContextRequested="Rows_ContextRequested">
                <!-- On no row (a row opens its own menu). -->
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="WorldsMenu_Import" Click="Import_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="WorldsMenu_OpenFolder" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="WorldsMenu_BackupsFolder" Command="{x:Bind ViewModel.OpenBackupsFolderCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA35;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="F5">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorldItemViewModel">
                        <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" DoubleTapped="World_DoubleTapped" Tag="{x:Bind}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE909;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                           Foreground="{x:Bind local:Bind.JobBrush(HasError), Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Played, Mode=OneWay}" /><Run Text="{x:Bind local:WorldsPanel.Separated(SizeText), Mode=OneWay}" /><Run Text="{x:Bind local:WorldsPanel.Separated(FolderNote), Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <ProgressRing Grid.Column="2" IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="16" Height="16" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Tag="{x:Bind}" Click="Play_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="Worlds_PlayButton"
                                        Visibility="{x:Bind local:Bind.Visible(CanPlay), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock x:Uid="Common_Play" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{x:Bind}" Click="Backup_Click" x:Uid="Worlds_BackupButton" IsEnabled="{x:Bind local:Bind.Not(IsBusy), Mode=OneWay}">
                                    <FontIcon Glyph="&#xEA35;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" x:Uid="Content_MoreButton">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="Worlds_RenameItem" Tag="{x:Bind}" Click="Rename_Click" KeyboardAcceleratorTextOverride="F2" IsEnabled="{x:Bind local:Bind.Not(HasError), Mode=OneWay}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Worlds_CopyItem" Tag="{x:Bind}" Click="Copy_Click" KeyboardAcceleratorTextOverride="Ctrl+D" IsEnabled="{x:Bind local:Bind.Not(HasError), Mode=OneWay}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Worlds_DataPacksItem" Tag="{x:Bind}" Click="DataPacks_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Worlds_CopySeedItem" Tag="{x:Bind}" Click="CopySeed_Click" IsEnabled="{x:Bind HasSeed, Mode=OneWay}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Worlds_ShortcutItem" Tag="{x:Bind}" Click="Shortcut_Click" IsEnabled="{x:Bind CanPlay, Mode=OneWay}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Content_ShowInFolder" Tag="{x:Bind}" Click="ShowInFolder_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+O">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Uid="Content_Delete" Tag="{x:Bind}" Click="Delete_Click" local:ShiftDelete.IsEnabled="True" KeyboardAcceleratorTextOverride="Del">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                        Visibility="{x:Bind local:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                <FontIcon Glyph="&#xE909;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="Worlds_Empty" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>

            <!-- Backups of the selected world (all backups when none is selected) -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.BackupsHeader, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" x:Uid="Worlds_BackUpNow" Click="BackupSelected_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    </Grid>
                    <ListView x:Name="BackupList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}" SelectionMode="None" Margin="-12,0"
                              ContextRequested="Rows_ContextRequested">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorldBackupItem">
                                <Grid ColumnSpacing="8" Padding="0,6" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind Backup.WorldFolder}" /><Run Text="{x:Bind local:WorldsPanel.Separated(Details)}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Tag="{x:Bind}" Click="Restore_Click" x:Uid="Worlds_Restore" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" x:Uid="Content_MoreButton" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Uid="Content_ShowInFolder" Tag="{x:Bind}" Click="BackupShowInFolder_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+O">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Content_Delete" Tag="{x:Bind}" Click="BackupDelete_Click" local:ShiftDelete.IsEnabled="True" KeyboardAcceleratorTextOverride="Del">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" x:Uid="Worlds_NoBackups" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Bind.Visible(ViewModel.HasNoBackups), Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
