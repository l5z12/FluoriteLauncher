<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fluorite.App.Views.ProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluorite.App.Views"
    xmlns:vm="using:Fluorite.App.ViewModels">

    <Grid Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="80" Height="80" CornerRadius="12" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Grid>
                    <FontIcon Glyph="&#xE74C;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image Source="{x:Bind ViewModel.Icon, Mode=OneWay}" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Project.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Project.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.Stats, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,0">
                    <HyperlinkButton x:Uid="Project_Website" Click="Link_Click" Tag="web" Visibility="{x:Bind local:Bind.VisibleIfText(ViewModel.Project.WebUrl), Mode=OneWay, FallbackValue=Collapsed}" />
                    <HyperlinkButton x:Uid="Project_Source" Click="Link_Click" Tag="source" Visibility="{x:Bind local:Bind.VisibleIfText(ViewModel.Project.SourceUrl), Mode=OneWay, FallbackValue=Collapsed}" />
                    <HyperlinkButton x:Uid="Project_Issues" Click="Link_Click" Tag="issues" Visibility="{x:Bind local:Bind.VisibleIfText(ViewModel.Project.IssuesUrl), Mode=OneWay, FallbackValue=Collapsed}" />
                    <HyperlinkButton x:Uid="Project_Wiki" Click="Link_Click" Tag="wiki" Visibility="{x:Bind local:Bind.VisibleIfText(ViewModel.Project.WikiUrl), Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
            </StackPanel>
            <!-- The width lives on the picker (hidden for modpacks), so a lone Install button hugs the right edge. -->
            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Uid="Project_InstallTo" MinWidth="300" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Instances}" SelectedIndex="{x:Bind ViewModel.InstanceIndex, Mode=TwoWay}"
                          Visibility="{x:Bind local:Bind.Collapsed(ViewModel.IsModpack), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsInstalling, Mode=OneWay}" Width="20" Height="20" />
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.InstallCommand}" IsEnabled="{x:Bind local:Bind.Not(ViewModel.IsInstalling), Mode=OneWay}" x:Uid="Project_InstallLatestButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Uid="Project_InstallLatest" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.InstalledVersion, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Right" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind local:Bind.IsNotNull(ViewModel.Error), Mode=OneWay, FallbackValue=False}" Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsClosable="False" />

        <SelectorBar x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Uid="Project_TabDescription" Tag="Description" IsSelected="True" />
            <SelectorBarItem x:Uid="Project_TabVersions" Tag="Versions" />
        </SelectorBar>

        <Grid x:Name="DescriptionPanel" Grid.Row="3" Margin="0,0,0,24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <WebView2 x:Name="Description" />
            </Border>
            <ProgressRing x:Name="DescriptionRing" IsActive="True" Width="32" Height="32" />
        </Grid>

        <Grid x:Name="VersionsPanel" Grid.Row="3" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox x:Uid="Project_OnlyCompatible" IsChecked="{x:Bind ViewModel.OnlyCompatible, Mode=TwoWay}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>
            <!-- Outdented by the item padding (16 left, 12 right) so row text lines up with the checkbox above. -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Versions}" SelectionMode="None" Margin="-16,0,-12,24">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionRow">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Number}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind Name}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Channel}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Button Grid.Column="2" x:Uid="Project_Changelog" Tag="{x:Bind}" Click="Changelog_Click" VerticalAlignment="Center" />
                            <Grid Grid.Column="3" MinWidth="110" VerticalAlignment="Center">
                                <Button x:Uid="Project_InstallVersion" Tag="{x:Bind}" Click="InstallVersion_Click" HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind local:Bind.Collapsed(IsInstalled), Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind local:Bind.Visible(IsInstalled), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Uid="Browse_Installed" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
