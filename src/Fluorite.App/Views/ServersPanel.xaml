<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fluorite.App.Views.ServersPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluorite.App.Views"
    xmlns:vm="using:Fluorite.App.ViewModels">

    <UserControl.Resources>
        <!-- Minecraft's text colours are made for a dark background, so the message of the day always gets one. -->
        <SolidColorBrush x:Key="MotdBackgroundBrush" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="MotdTextBrush" Color="#FFA8A8A8" />
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanModify, Mode=OneWay}" x:Uid="Servers_AddButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="Servers_Add" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" x:Uid="Servers_RefreshButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Uid="Servers_Refresh" />
                </StackPanel>
            </Button>
            <ProgressRing Grid.Column="2" HorizontalAlignment="Left" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar x:Uid="Servers_RunningBar" Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.IsGameRunning, Mode=OneWay}" />
            <InfoBar Severity="Success" IsClosable="True" IsOpen="{x:Bind local:Bind.IsNotNull(ViewModel.Status), Mode=OneWay, FallbackValue=False}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" />
            <InfoBar Severity="Error" IsClosable="True" IsOpen="{x:Bind local:Bind.IsNotNull(ViewModel.Error), Mode=OneWay, FallbackValue=False}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            <local:UndoBar Offer="{x:Bind ViewModel.PendingUndo, Mode=OneWay}" />
        </StackPanel>

        <ListView x:Name="List" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}" SelectionMode="Single"
                  CanDragItems="{x:Bind ViewModel.CanModify, Mode=OneWay}" CanReorderItems="{x:Bind ViewModel.CanModify, Mode=OneWay}"
                  AllowDrop="{x:Bind ViewModel.CanModify, Mode=OneWay}" DragItemsCompleted="List_DragItemsCompleted"
                  ContextRequested="List_ContextRequested">
            <!-- On no row (a row opens its own menu). -->
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Servers_Add" Click="AddServer_Click" IsEnabled="{x:Bind ViewModel.CanModify, Mode=OneWay}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Servers_Refresh" Click="RefreshServers_Click" KeyboardAcceleratorTextOverride="F5">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerItemViewModel">
                    <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" DoubleTapped="Server_DoubleTapped" Tag="{x:Bind}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE968;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Address, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Background="{StaticResource MotdBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" MinWidth="240">
                                <Grid>
                                    <TextBlock local:MotdText.Spans="{x:Bind Motd, Mode=OneWay}" Foreground="{StaticResource MotdTextBrush}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" Visibility="{x:Bind local:Bind.Visible(IsPinging), Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MinWidth="96">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <FontIcon Glyph="{x:Bind SignalGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind local:ServersPanel.SignalBrush(IsOnline), Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind PlayersText, Mode=OneWay}" HorizontalAlignment="Right" ToolTipService.ToolTip="{x:Bind PlayersTooltip, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind VersionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Right" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Tag="{x:Bind}" Click="Join_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="Servers_JoinButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock x:Uid="Servers_Join" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" x:Uid="Content_MoreButton">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="Servers_EditItem" Tag="{x:Bind}" Click="Edit_Click" KeyboardAcceleratorTextOverride="F2">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Servers_CopyAddressItem" Tag="{x:Bind}" Click="CopyAddress_Click" KeyboardAcceleratorTextOverride="Ctrl+C">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Worlds_ShortcutItem" Tag="{x:Bind}" Click="Shortcut_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <!-- The keyboard's way to drag a server into place. -->
                                        <MenuFlyoutItem x:Uid="Accounts_MoveUp" Tag="{x:Bind}" Click="MoveUp_Click" KeyboardAcceleratorTextOverride="Alt+Up">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Accounts_MoveDown" Tag="{x:Bind}" Click="MoveDown_Click" KeyboardAcceleratorTextOverride="Alt+Down">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Uid="Content_Delete" Tag="{x:Bind}" Click="Delete_Click" KeyboardAcceleratorTextOverride="Del">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind local:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE968;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="Servers_Empty" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Uid="Servers_ReorderHint" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,8"
                   Visibility="{x:Bind local:Bind.Collapsed(ViewModel.IsEmpty), Mode=OneWay}" />
    </Grid>
</UserControl>
